# Railway Bucket (S3-compatible)
RAILWAY_ENDPOINT=https://your-railway-bucket-endpoint
RAILWAY_ACCESS_KEY=your_railway_access_key
RAILWAY_SECRET_KEY=your_railway_secret_key
RAILWAY_BUCKET_NAME=your_railway_bucket_name
RAILWAY_REGION=auto

# AWS S3
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your_aws_bucket_name

# Sync interval in seconds (default: 60)
SYNC_INTERVAL=3600

# Set to "true" to delete from AWS files removed from Railway
ENABLE_DELETE=false
